{
  "name": "deskling",
  "productName": "Deskling",
  "version": "0.3.1",
  "description": "A little creature that lives on your desktop and helps out: Microsoft Agent characters, local Ollama brain.",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "preview": "electron . --preview",
    "test": "node --test test/*.test.mjs",
    "validate": "node tools/validate-character.mjs",
    "import:clippyjs": "node tools/import-clippyjs.mjs",
    "import:sheet": "node tools/import-sheet.mjs",
    "dist": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rickkwang.deskling",
    "productName": "Deskling",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "characters/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Deskling"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rickkwang",
        "repo": "Deskling",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en",
      "zh_CN",
      "zh_TW"
    ]
  }
}
